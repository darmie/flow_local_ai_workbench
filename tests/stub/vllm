#!/usr/bin/env python3
"""Stub of the `vllm` CLI for harness smoke tests.

`vllm serve` -> tiny HTTP server with /health, /metrics, /v1/models.
`vllm bench serve` -> writes a result JSON with the keys summarize.py reads.
"""
import http.server
import json
import os
import random
import subprocess
import sys
import time


def serve(argv):
    port = int(argv[argv.index("--port") + 1]) if "--port" in argv else 8000

    t0 = time.time()

    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            # Counters grow with uptime so per-run deltas are non-zero.
            n = int(time.time() - t0)
            metrics = (f"process_start_time_seconds {t0}\n"
                       f"vllm:num_requests_running 0\nvllm:kv_cache_usage_perc 0.1\n"
                       f"vllm:request_success_total{{finished_reason=\"stop\"}} {n}\n"
                       f"vllm:e2e_request_latency_seconds_sum {0.8 * n}\n"
                       f"vllm:time_to_first_token_seconds_sum {0.1 * n}\n"
                       f"vllm:time_to_first_token_seconds_count {n}\n"
                       f"vllm:prompt_tokens_total {500 * n}\nvllm:generation_tokens_total {80 * n}\n").encode()
            body = {"/health": b"", "/v1/models": b'{"data":[{"id":"stub"}]}', "/metrics": metrics}.get(self.path)
            self.send_response(200 if body is not None else 404)
            self.end_headers()
            self.wfile.write(body or b"")

        def log_message(self, *a):
            pass

    http.server.ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()


def bench(argv):
    get = lambda k, d=None: argv[argv.index(k) + 1] if k in argv else d
    conc = int(get("--max-concurrency", 1))
    n = int(get("--num-prompts", 10))
    assert get("--tokenizer"), "harness must pass --tokenizer"
    assert os.environ.get("HF_HUB_OFFLINE") == "1", "local client must run offline"
    out_len = int(get("--random-output-len", get("--prefix-repetition-output-len", 128)))
    if os.environ.get("STUB_FAIL_DATASET") == get("--dataset-name"):
        # Real vLLM exits 0 with completed=0 when every request is rejected.
        os.makedirs(get("--result-dir"), exist_ok=True)
        json.dump({"completed": 0, "failed": n, "request_throughput": 0.0, "output_throughput": 0.0},
                  open(os.path.join(get("--result-dir"), get("--result-filename")), "w"))
        return
    time.sleep(1.5)
    crash_at = os.environ.get("STUB_CRASH_CONC")
    marker = os.path.join(get("--result-dir"), ".stub_crashed")
    if crash_at and int(crash_at) == conc and not os.path.exists(marker):
        # Simulate the server dying mid-point (e.g. OOM): stop it, all requests fail.
        open(marker, "w").close()
        port = get("--base-url").rsplit(":", 1)[-1]
        subprocess.run(["pkill", "-f", f"vllm serve --port {port}"])
        json.dump({"completed": 0, "failed": n, "request_throughput": 0.0, "output_throughput": 0.0},
                  open(os.path.join(get("--result-dir"), get("--result-filename")), "w"))
        return
    in_tokens = 512
    if get("--dataset-name") == "custom":
        # Approximate prompt tokens from characters so languages differ like real fertility.
        rows = [json.loads(l) for l in open(get("--dataset-path")) if l.strip()]
        in_tokens = int(sum(len(r["prompt"]) for r in rows) / len(rows) / 4)
    tpot = 20 * (1 + 0.3 * conc) * random.uniform(0.95, 1.05)
    ttft = 150 * conc * in_tokens / 512 * random.uniform(0.95, 1.05)
    dur = n / conc * (ttft + tpot * out_len) / 1000
    res = {"completed": n, "failed": 0, "duration": dur, "total_input_tokens": n * in_tokens,
           "total_output_tokens": n * out_len, "request_throughput": n / dur,
           "request_goodput": n / dur * (1.0 if tpot < 150 and ttft < 2000 else 0.2),
           "output_throughput": n * out_len / dur, "max_concurrent_requests": conc}
    for m, base in (("ttft", ttft), ("tpot", tpot), ("itl", tpot), ("e2el", ttft + tpot * out_len)):
        res[f"mean_{m}_ms"] = res[f"median_{m}_ms"] = base
        for p in (50, 90, 95, 99):
            res[f"p{p}_{m}_ms"] = base * (1 + p / 200)
    os.makedirs(get("--result-dir"), exist_ok=True)
    json.dump(res, open(os.path.join(get("--result-dir"), get("--result-filename")), "w"))


if __name__ == "__main__":
    if sys.argv[1:2] == ["serve"]:
        serve(sys.argv[2:])
    elif sys.argv[1:3] == ["bench", "serve"]:
        bench(sys.argv[3:])
    else:
        sys.exit(f"stub vllm: unsupported {sys.argv[1:]}")
